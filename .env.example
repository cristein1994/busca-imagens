# Obtenha sua Access Key em: https://unsplash.com/developers
# Crie um app e copie a "Access Key"
VITE_UNSPLASH_ACCESS_KEY=sua_access_key_aqui

# Chave da API do Grok. Fica só no servidor (sem prefixo VITE_).
# Crie em: https://console.x.ai/
XAI_API_KEY=sua_api_key_aqui

# Opcional. Padrão: grok-4.7
# GROK_MODEL=grok-4.7
