# Ollama OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama

# Default: ThalisAI GLM-4.7-Flash-heretic Q4_K_M via Ollama HF
OLLAMA_MODEL=hf.co/ThalisAI/GLM-4.7-Flash-heretic:Q4_K_M

# Tor SOCKS5 (local daemon or docker compose service)
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050

# Optional OpenAI-compatible remote (overrides Ollama when set)
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=glm-4.7-flash-heretic
